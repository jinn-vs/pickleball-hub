# ─────────── Site (branding — swap per website, no code changes) ───────────
NEXT_PUBLIC_SITE_NAME="Pickleball Hub"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TWITTER="@pickleball"

# ─────────── Supabase ───────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. NEVER expose to the client. Used only in /api write routes.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─────────── Admin access control ───────────
# Comma-separated emails allowed into the admin panel (fallback to app_metadata.role).
ADMIN_EMAILS="you@example.com"

# ─────────── Revalidation (external webhook trigger only) ───────────
REVALIDATE_SECRET="generate-a-long-random-string"
